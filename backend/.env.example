PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=event
JWT_SECRET=replace-with-a-long-random-secret
# Dedicated secrets (optional, fallback to JWT_SECRET and derived refresh secret if omitted)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
# Industry standard token lifetimes: 15m for access token, 7d for refresh token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173

